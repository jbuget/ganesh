# Entra ID — app registration shared with WAATcher
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/auth/callback/azure-ad

# What the BFF calls: never exposed to the browser (no NEXT_PUBLIC_ prefix)
API_URL=http://localhost:8000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000

# Seals the session cookie. Its own per environment, and never committed:
# a shared secret would let a session forged elsewhere be spent here.
# Without it, the Entra callback fails for everyone.
SESSION_SECRET=

# Who may come in, beyond what the tenant already allows.
ALLOWED_EMAIL_DOMAIN=waat.fr

# Which door the sign-in screen offers. To be kept in step with AUTH_ENTRA on
# the API side.
AUTH_ENTRA=true

# Development only: skips signing in altogether. To be kept in step with
# REQUIRE_AUTH on the API side, or the screens open on an API that turns them
# away. Ignored in production.
AUTH_DISABLED=false

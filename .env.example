COMPOSE_PROJECT_NAME=timesheet

# Ports (surchargeables)
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
# MinIO: l'API et sa console. WAATcher tient 9001-9003 et 9011-9013.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9010
# MailPit: le SMTP où atterrissent les rappels, et la boîte où on les lit.
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

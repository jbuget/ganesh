# ---------------------------------------------------------------------------
# Production reverse proxy for the Ganesh API host (EC2).
# Caddy terminates TLS with certificates it obtains and renews by itself.
#
# Prerequisites before the first boot:
#   - DNS: api.ganesh.waat.tools  A  <the Elastic IP, `terraform output public_ip`>
#     It must resolve first, or the ACME challenge fails.
#   - Security group: 80 and 443 open to 0.0.0.0/0 (HTTP-01 challenge, then serving).
#
# `ganesh.waat.tools` is not served here: that is Amplify's.
# ---------------------------------------------------------------------------

api.ganesh.waat.tools {
	encode gzip zstd

	# What a request may weigh, envelope included — the same number the API
	# carries in `MAX_REQUEST_BYTES`, said here because this is where it
	# actually bites. A file is capped at ten megabytes by the domain, but
	# that rule is only read once the whole body has been taken in and
	# spooled to disk: without this line, a single POST of several gigabytes
	# fills the host before anything of ours is consulted.
	request_body {
		max_size 12MB
	}

	# The API on the internal compose network; `api` resolves through Docker's
	# own DNS. Nothing else on this host answers on 8000.
	reverse_proxy api:8000 {
		health_uri /api/v1/health
		health_interval 30s
	}
}

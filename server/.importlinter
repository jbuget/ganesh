[importlinter]
root_packages =
    src
include_external_packages = True

# --- Domain purity -----------------------------------------------------------
# The domain knows neither SQLAlchemy, nor FastAPI, nor any framework.
[importlinter:contract:domain-purity]
name = The domain depends on no framework
type = forbidden
source_modules =
    src.modules.*.domain
forbidden_modules =
    sqlalchemy
    fastapi
    alembic
    pydantic
    httpx
    starlette

# --- Which way dependencies run between layers -------------------------------
# domain/ -> importing infrastructure/ or presentation/ is forbidden
[importlinter:contract:domain-isolation]
name = The domain imports neither infrastructure nor presentation
type = forbidden
source_modules =
    src.modules.*.domain
forbidden_modules =
    src.modules.*.infrastructure
    src.modules.*.presentation

# application/ -> importing infrastructure/ or presentation/ is forbidden
[importlinter:contract:application-isolation]
name = The application imports neither infrastructure nor presentation
type = forbidden
source_modules =
    src.modules.*.application
forbidden_modules =
    src.modules.*.infrastructure
    src.modules.*.presentation

# infrastructure/ -> importing presentation/ is forbidden
[importlinter:contract:infrastructure-isolation]
name = The infrastructure does not import presentation
type = forbidden
source_modules =
    src.modules.*.infrastructure
forbidden_modules =
    src.modules.*.presentation

# --- Shared code -------------------------------------------------------------
# shared/ is a core: it knows no business module.
[importlinter:contract:shared-purity]
name = shared/ depends on no business module
type = forbidden
source_modules =
    src.shared
forbidden_modules =
    src.modules.*

# --- Boundaries of cross-cutting code ----------------------------------------
# common/ carries cross-cutting technical code (handlers, middlewares): it
# knows no business module.
[importlinter:contract:common-purity]
name = common/ depends on no business module
type = forbidden
source_modules =
    src.common
forbidden_modules =
    src.modules.*

# --- The MCP server ----------------------------------------------------------
# A second presentation: it reaches the use cases the routers reach, and
# nothing reaches back. A module that came looking for a tool would have
# inverted the direction the architecture runs in.
[importlinter:contract:mcp-is-a-leaf]
name = Nothing imports the MCP server but the entry point
type = forbidden
source_modules =
    src.modules
    src.common
    src.shared
    src.scheduler
forbidden_modules =
    src.mcp

# The tools call use cases, never a repository — the rule the routes follow.
# Indirect is allowed on purpose: a tool reaches the module's `dependencies`,
# whose whole job is to build the repositories, exactly as a router does.
[importlinter:contract:mcp-calls-use-cases]
name = The MCP server names no repository of its own
type = forbidden
allow_indirect_imports = True
source_modules =
    src.mcp
forbidden_modules =
    src.modules.projects.infrastructure
    src.modules.entries.infrastructure
    src.modules.months.infrastructure
    src.modules.audit_logs.infrastructure
    src.modules.users.infrastructure

# --- The clock ---------------------------------------------------------------
# A third way in, beside the routers and the tools: they answer a request and a
# sentence, this one answers a clock. Same shape, so the same two contracts.
[importlinter:contract:scheduler-is-a-leaf]
name = Nothing imports the clock but the entry point
type = forbidden
source_modules =
    src.modules
    src.common
    src.shared
    src.mcp
forbidden_modules =
    src.scheduler

# It reaches a use case through the module's `dependencies`, whose whole job is
# to build the repositories — exactly as a router does, and as a tool does.
[importlinter:contract:scheduler-calls-use-cases]
name = The clock names no repository of its own
type = forbidden
allow_indirect_imports = True
source_modules =
    src.scheduler
forbidden_modules =
    src.modules.projects.infrastructure
    src.modules.entries.infrastructure
    src.modules.months.infrastructure
    src.modules.audit_logs.infrastructure
    src.modules.users.infrastructure
    src.modules.notifications.infrastructure

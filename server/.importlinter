[importlinter]
root_packages =
    src
include_external_packages = True

# --- Domain purity -----------------------------------------------------------
# The domain knows neither SQLAlchemy, nor FastAPI, nor any framework.
[importlinter:contract:domain-purity]
name = The domain depends on no framework
type = forbidden
source_modules =
    src.modules.*.domain
forbidden_modules =
    sqlalchemy
    fastapi
    alembic
    pydantic
    httpx
    starlette

# --- Which way dependencies run between layers -------------------------------
# domain/ -> importing infrastructure/ or presentation/ is forbidden
[importlinter:contract:domain-isolation]
name = The domain imports neither infrastructure nor presentation
type = forbidden
source_modules =
    src.modules.*.domain
forbidden_modules =
    src.modules.*.infrastructure
    src.modules.*.presentation

# application/ -> importing infrastructure/ or presentation/ is forbidden
[importlinter:contract:application-isolation]
name = The application imports neither infrastructure nor presentation
type = forbidden
source_modules =
    src.modules.*.application
forbidden_modules =
    src.modules.*.infrastructure
    src.modules.*.presentation

# infrastructure/ -> importing presentation/ is forbidden
[importlinter:contract:infrastructure-isolation]
name = The infrastructure does not import presentation
type = forbidden
source_modules =
    src.modules.*.infrastructure
forbidden_modules =
    src.modules.*.presentation

# --- Shared code -------------------------------------------------------------
# shared/ is a core: it knows no business module.
[importlinter:contract:shared-purity]
name = shared/ depends on no business module
type = forbidden
source_modules =
    src.shared
forbidden_modules =
    src.modules.*

# --- Boundaries of cross-cutting code ----------------------------------------
# common/ carries cross-cutting technical code (handlers, middlewares): it
# knows no business module.
[importlinter:contract:common-purity]
name = common/ depends on no business module
type = forbidden
source_modules =
    src.common
forbidden_modules =
    src.modules.*

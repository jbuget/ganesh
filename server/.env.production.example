# The production server/.env, as the host reads it.
#
# This file is a template: fill a copy in, never commit the copy, and push it
# to Parameter Store, which is where production actually reads it from:
#
#   aws ssm put-parameter --profile waat-prod --region eu-west-3 \
#     --name /ganesh/production/env --type SecureString --overwrite \
#     --value file://server/.env.production
#
# The host pulls it at every deploy and writes it to server/.env. It never
# passes through the SSM command payload, which is logged.

ENVIRONMENT=production
DEBUG=false

API_PREFIX=/api/v1
API_URL=https://api.ganesh.waat.tools

# The client is the only browser-side caller, and it goes through its own BFF,
# so nothing cross-origin should ever reach here. Declared all the same: an
# empty list is a decision nobody wrote down, this one is.
ALLOWED_ORIGINS=["https://ganesh.waat.tools"]

# The RDS endpoint (`terraform output rds_endpoint`) and the master password
# (`aws ssm get-parameter --name /ganesh/production/db_password --with-decryption`).
DATABASE_URL=postgresql+asyncpg://timesheet:<password>@<rds-endpoint>:5432/timesheet

# Microsoft Entra ID — the server only validates tokens; the client secret is
# the BFF's business and lives in Amplify, not here.
AZURE_AD_TENANT_ID=28d878fd-3802-4f94-931c-79cdf0a419dc
AZURE_AD_CLIENT_ID=c03d14e8-e876-4703-94a0-99bbda5d5d9d

# The sign-in flow has landed: every request must now carry a token. Left at
# false, the API would take every caller for j.buget@waat.fr — whoever reaches
# the address would be a full user, signed in or not.
REQUIRE_AUTH=true

# Which door people come in by. AUTH_ENTRA=false opens the fallback one — a
# single account, one password — while Entra has yet to declare the
# application. Never both: with Entra on, the local route does not exist.
AUTH_ENTRA=true
AUTH_LOGIN=admin
# Generated per environment, and never committed. Empty, the fallback door
# stays shut rather than opening to whoever leaves the field blank.
AUTH_PASSWORD=
AUTH_LOCAL_EMAIL=j.buget@waat.fr
# Signs the tokens of the fallback door. Its own per environment: a shared key
# would let a session forged in one be spent in another.
SECRET_KEY=

# What a whole request may weigh, envelope included. Caddy is told the same
# number and is what keeps the bytes off the host; this is the API saying its
# own limit, for an instance that ever sits behind another proxy, or none.
# Raising it means raising it in the Caddyfile too, or the proxy answers 413
# first and the API never sees the request.
MAX_REQUEST_BYTES=12582912

API_KEY_RATE_ALLOWANCE=120
API_KEY_RATE_WINDOW_SECONDS=60

# La Gazette — the chapeau a model writes over each digest. Optional: left
# empty, digests are generated with their facts and no chapeau, and nothing
# else changes. The key is a Google AI Studio one, and it is a secret like any
# other here — it reaches the host inside this file, never through Terraform
# and never through the SSM command payload.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The files a project carries, in the bucket Terraform creates (the
# `attachments_bucket` output). No key beside it: the instance carries an IAM
# role and botocore finds it on its own. A key written here would be a key to
# rotate, for nothing.
S3_BUCKET=ganesh-attachments
S3_REGION=eu-west-3

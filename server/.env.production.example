# The production server/.env, as the host reads it.
#
# This file is a template: fill a copy in, never commit the copy, and push it
# to Parameter Store, which is where production actually reads it from:
#
#   aws ssm put-parameter --profile waat-prod --region eu-west-3 \
#     --name /ganesh/production/env --type SecureString --overwrite \
#     --value file://server/.env.production
#
# The host pulls it at every deploy and writes it to server/.env. It never
# passes through the SSM command payload, which is logged.

ENVIRONMENT=production
DEBUG=false

API_PREFIX=/api/v1
API_URL=https://api.ganesh.waat.tools

# The client is the only browser-side caller, and it goes through its own BFF,
# so nothing cross-origin should ever reach here. Declared all the same: an
# empty list is a decision nobody wrote down, this one is.
ALLOWED_ORIGINS=["https://ganesh.waat.tools"]

# The RDS endpoint (`terraform output rds_endpoint`) and the master password
# (`aws ssm get-parameter --name /ganesh/production/db_password --with-decryption`).
DATABASE_URL=postgresql+asyncpg://timesheet:<password>@<rds-endpoint>:5432/timesheet

# Microsoft Entra ID — the server only validates tokens; the client secret is
# the BFF's business and lives in Amplify, not here.
AZURE_AD_TENANT_ID=28d878fd-3802-4f94-931c-79cdf0a419dc
AZURE_AD_CLIENT_ID=c03d14e8-e876-4703-94a0-99bbda5d5d9d

# TEMPORARY. The BFF has no sign-in route yet: with REQUIRE_AUTH=true nobody
# can obtain a token, and the application answers 401 to everyone. Until the
# Entra flow ships, this must be false — which means the application is open
# to whoever knows the address. Flip it the day the flow lands, and not a day
# later.
REQUIRE_AUTH=false

API_KEY_RATE_ALLOWANCE=120
API_KEY_RATE_WINDOW_SECONDS=60

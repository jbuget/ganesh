ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api/v1
API_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://timesheet:timesheet@localhost:5432/timesheet

# Microsoft Entra ID — le serveur ne valide que les jetons, il n'a pas besoin du secret
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
REQUIRE_AUTH=true

ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api/v1
API_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://timesheet:timesheet@localhost:5432/timesheet

# Microsoft Entra ID — the server only validates tokens, it needs no secret
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
REQUIRE_AUTH=true

# REQUIRE_AUTH=false ouvre la porte en developpement : le compte remis est
# celui-ci, et il est provisionne administrateur — sans porte, personne ne
# pourrait le promouvoir. Changer cette ligne puis redemarrer, c'est signer
# comme quelqu'un d'autre ; pour lire l'application comme un demandeur,
# deplacer ce compte avec `make grant-role EMAIL=... ROLE=GUEST`.
# Sans effet des que REQUIRE_AUTH est vrai.
DEV_EMAIL=j.buget@waat.fr

# Combien d'appels une cle d'API peut passer, et sur quelle duree. Compte par
# processus : derriere plusieurs workers, la limite effective est multipliee
# par leur nombre.
API_KEY_RATE_ALLOWANCE=120
API_KEY_RATE_WINDOW_SECONDS=60

# La Gazette — the chapeau a model writes over each numéro. Leave it empty and
# numéros go out on their facts alone.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The files a project carries. In production the instance carries an IAM role
# and both keys stay empty; locally the address is the MinIO of
# docker-compose, which answers the same API.
S3_BUCKET=ganesh-attachments
S3_REGION=eu-west-3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=ganesh
S3_SECRET_ACCESS_KEY=ganesh-secret

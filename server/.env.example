ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api/v1
API_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://timesheet:timesheet@localhost:5432/timesheet

# Microsoft Entra ID — the server only validates tokens, it needs no secret
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
REQUIRE_AUTH=true

# Combien d'appels une cle d'API peut passer, et sur quelle duree. Compte par
# processus : derriere plusieurs workers, la limite effective est multipliee
# par leur nombre.
API_KEY_RATE_ALLOWANCE=120
API_KEY_RATE_WINDOW_SECONDS=60
